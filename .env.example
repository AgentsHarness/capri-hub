# cp .env.example .env —— 至少要改 FE_TOKEN。
# 这个文件会被 docker compose 读进容器环境，别提交你填好的 .env。

# ── 必填 ───────────────────────────────────────────────────────────────

# 浏览器门禁。生成一个：openssl rand -hex 24
# 空着并且 REQUIRE_FE_TOKEN=1 时，hub 会拒绝启动而不是裸奔。
FE_TOKEN=

# 没有 FE_TOKEN 就不启动。公网部署务必保留 1 ——
# 否则任何人都能列出你的 host 并向它们发指令。
REQUIRE_FE_TOKEN=1

# ── QUIC（host 的主通道，UDP 8788）────────────────────────────────────

# 一旦设了 FE_TOKEN，hub 就认为这是生产环境、要求真证书；没有证书又没有
# 这一项时它会关掉 QUIC，让所有 host 退回 WebSocket —— 只在日志里留一行
# "QUIC TLS 初始化失败"，功能不坏但更慢，非常容易漏掉。
# host 侧拨 QUIC 时本来就跳过证书校验，所以自签在这里是安全的。
QUIC_ALLOW_SELF_SIGNED=1

# 有真证书就换成这两项（容器内路径，记得挂载进去），并删掉上面那行：
# QUIC_CERT=/data/certs/fullchain.pem
# QUIC_KEY=/data/certs/privkey.pem

# ── 可选 ───────────────────────────────────────────────────────────────

# 前端真实来源。默认 * 允许所有来源。
# CORS_ORIGINS=https://capri.example.com

# 容器内端口。改了要同步 docker-compose.yml 里的端口映射。
# PORT=8787
# QUIC_PORT=8788

# 影响日志时间戳和 `capri-hub paircode` 显示的配对码有效期。
# 留成 UTC 的话，你看到的过期时间会和挂钟差好几个小时。
TZ=Asia/Shanghai
