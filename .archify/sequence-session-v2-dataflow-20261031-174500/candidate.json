  "cards": [
    {
      "dot": "cyan",
      "title": "单一序列与累计确认",
      "items": [
        "会话 = (hostId, epoch)；新 epoch 重置双向 seq，audience.gen 继续递增",
        "每个方向一条无洞 seq；ack=N 表示 ≤N 的可靠帧已应用",
        "events 帧的 seq 是首事件 seq；hub 逐事件推进上行水位",
        "FE 水位与 host 事件 seq 同坐标；trimmed 保留原 seq",
        "keepalive 5s；idle 20s；RTO 10s（2×keepalive）；请求确认期 15s（3×keepalive）",
        "正常关闭由传输层 CloseReason 表达，没有 JSON close 帧"
      ]
    },
    {
      "dot": "emerald",
      "title": "观众状态决定上行",
      "items": [
        "hello_ack.audience 是握手时的绝对快照",
        "audience{gen,watchers,all,sessions} 每次变化整帧下发",
        "watchers==0 暂停上传；all:true 时 host 不裁剪",
        "sessions 是显示会话加一层子代理子会话"
      ]
    },
    {
      "dot": "orange",
      "title": "中继平面",
      "items": [
        "request 是下行可靠帧，host 的累计 ack 证明送达",
        "respond 不占会话 seq（seq:0），按 1MiB 分块并携带 ack",
        "hub 按 reqId 路由；最终块关闭该请求",
        "relay memo 按 (hubBoot, reqId) 去重；应答可跨同 hubBoot 会话重发"
      ]
    }
  ]
